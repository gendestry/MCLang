!WHITESPACE = [ \t\r\n]+
# Comments must come before DIV, otherwise '/' would match first.
!LINE_COMMENT = //[^\n]*
!BLOCK_COMMENT = /\*[\s\S]*?\*/

# ---- literals ----------------------------------------------------------------
NUM = (?:[1-9][0-9]*|0)(?:\.[0-9]+)?
# A string literal keeps its quotes; AstBuilder strips them.
STRING_LIT = "[^"\n]*"

# ---- keywords ----------------------------------------------------------------
# \b keeps keywords from matching the start of identifiers such as "integer".
RECORD = record\b
RETURN = return\b
FOR = for\b
WHILE = while\b
IF = if\b
ELSE = else\b
TRUE = true\b
FALSE = false\b

STRING = string\b
FLOAT = float\b
CHAR = char\b
VOID = void\b
BOOL = bool\b

NEQ = [!]=
ISEQ = [=]=
LEQ = <=
GEQ = >=
AND = &&
OR = \|\|

LT = <
GT = >
NOT = [!]
AMP = &
EQ = [=]
PLUS = \+
MINUS = -
MUL = \*
DIV = /
LPAREN = \(
RPAREN = \)
LBRACKET = \[
RBRACKET = \]

# ---- punctuation -------------------------------------------------------------
COMMA = ,
DOT = \.
SEMIC = ;

LCURLY = \{
RCURLY = \}

# ---- identifiers (last, so keywords win) -------------------------------------
IDENTIFIER = [A-Za-z0-9]+